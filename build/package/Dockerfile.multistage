# syntax=docker/dockerfile:1

##
## Build
##
FROM golang:1.17-alpine3.14 AS builder

WORKDIR /app

COPY ../../go.mod ./
COPY ../../go.sum ./
RUN go mod download

COPY ../../cmd/server/*.go ./

RUN go build -o /gogogo-server

##
## Deploy
##
FROM alpine:3.14

WORKDIR /

COPY --from=builder /gogogo-server /gogogo-server

EXPOSE 8080

USER nobody:nobody

ENTRYPOINT ["/gogogo-server"]
